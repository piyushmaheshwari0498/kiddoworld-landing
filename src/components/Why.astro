---
import Icon from './Icon.astro';
import { content } from '../lib/site.js';
const w = content.why;
---
<section>
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{w.eyebrow}</span>
      <h2>{w.title}</h2>
    </div>
    <div class="why-grid">
      {w.items.map((i) => (
        <div class="why-card">
          <div class="why-icon"><Icon name={i.icon} /></div>
          <h3>{i.title}</h3>
          <p>{i.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
