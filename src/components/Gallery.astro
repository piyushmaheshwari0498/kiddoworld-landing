---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { site, content } from '../lib/site.js';

const g = content.gallery;

// Every photo inside /gallery (project root) is picked up automatically at build time.
const files = import.meta.glob('../../gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
  eager: true,
  import: 'default',
});

const collator = new Intl.Collator('en', { numeric: true, sensitivity: 'base' });
const names = Object.keys(files).sort((a, b) => collator.compare(a, b));

const images = await Promise.all(
  names.map(async (path, i) => {
    const src = files[path];
    const [thumb, full] = await Promise.all([
      getImage({ src, width: 640, format: 'webp', quality: 78 }), // keeps the photo's own shape (posters aren't cropped)
      getImage({ src, width: 1600, format: 'webp', quality: 82 }),
    ]);
    const base = path.split('/').pop().replace(/\.[^.]+$/, '');
    // "03-factory floor.jpg" -> "factory floor"
    let alt = base.replace(/^\d+[-_.\s]*/, '').replace(/[-_]+/g, ' ').trim();
    // Camera / WhatsApp default names (PHOTO-2026-…, IMG_1234, WhatsApp Image …) make poor captions.
    if (!alt || /^(photo|img|image|dsc|pxl|whatsapp|screenshot|picture)\b/i.test(alt) || /^[\d\s.:-]+$/.test(alt)) alt = `Kiddo World toys – photo ${i + 1}`;
    return { thumb: thumb.src, full: full.src, alt, w: thumb.attributes.width, h: thumb.attributes.height };
  })
);

const show = images.length > 0 || site.showPlaceholders;
---
{show && (
  <section id="photos" class="alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{g.eyebrow}</span>
        <h2>{g.title}</h2>
      </div>
      <div class="gallery-grid">
        {images.length > 0
          ? images.map((img) => (
              <button type="button" class="gallery-item" data-full={img.full} aria-label={`View photo: ${img.alt}`}>
                <img src={img.thumb} alt={img.alt} loading="lazy" decoding="async" width={img.w} height={img.h} />
              </button>
            ))
          : Array.from({ length: 8 }).map(() => (
              <div class="gallery-item ph">
                <div class="photo-placeholder"><Icon name="image" /><span>Add photos to the gallery folder</span></div>
              </div>
            ))}
      </div>
    </div>
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button type="button" id="lightboxClose" aria-label="Close"><Icon name="close" /></button>
      <button type="button" class="lb-nav prev" id="lightboxPrev" aria-label="Previous photo"><Icon name="arrow" /></button>
      <button type="button" class="lb-nav next" id="lightboxNext" aria-label="Next photo"><Icon name="arrow" /></button>
      <img id="lightboxImg" alt="" />
    </div>
  </section>
)}
