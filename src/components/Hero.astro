---
import Icon from './Icon.astro';
import { site, content, categories, waLink } from '../lib/site.js';
const h = content.hero;
---
<section class="hero">
  <div class="container hero-grid">
    <span class="eyebrow">{h.eyebrow}</span>
    <h1>{h.title}<br />{h.titleAccentLine} <span class="hl">{h.titleAccentWord}</span>.</h1>
    <p class="lead">{h.lead}</p>
    <div class="hero-actions">
      <a href={site.shopUrl} class="btn btn-primary"><Icon name="cart" />Shop Now</a>
      <a href={waLink()} class="btn btn-whatsapp" target="_blank" rel="noopener"><Icon name="whatsapp" />Enquire on WhatsApp</a>
      <a href="#contact" class="btn btn-outline"><Icon name="message" />Send an Enquiry</a>
    </div>
    <div class="hero-pills" aria-hidden="true">
      {categories.map((c) => <span>{c.label}</span>)}
    </div>
  </div>
</section>
